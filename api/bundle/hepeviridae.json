group":null,"genome":"ssRNA(+/-)","n_isolates":1,"common":"greater white-toothed shrew hepatitis E virus"}],"highlights":[{"id":"root/riboviria/orthornavirae/kitrinoviricota/alsuviricetes/hepelivirales/hepeviridae/orthohepevirinae/paslahepevirus/paslahepevirus-balayani","name":"Paslahepevirus balayani","tier":"established","serogroup":null,"headline":"The commonest cause of acute viral hepatitis worldwide, and two diseases in one species: a waterborne epidemic hepatitis of low-income settings, and a zoonotic foodborne infection of high-income ones.","common":"hepatitis E virus genotypes 1-4 (HEV)"}],"morphology_key":"Hepeviridae (2)"},"root/riboviria/orthornavirae/kitrinoviricota/alsuviricetes/hepelivirales/hepeviridae/orthohepevirinae/paslahepevirus/paslahepevirus-alci":{"name":"Paslahepevirus alci","rank":"species","n_species":1,"tiers":{"unassessed":1},"top_tier":"unassessed","note":null,"meta":{"species":"Paslahepevirus alci","genus":"Paslahepevirus","family":"Hepeviridae","genome":"ssRNA(+)","host":"vertebrates","hosts":["Vertebrates"],"serogroup":null,"clade":null,"profiled":false,"tier":"unassessed","basis":"none","tier_note":"Not assessed. This species has no curated profile here and no human-derived isolate in the ICTV record — which is not the same as evidence against human infection."},"isolates":[{"names":["moose hepatitis E virus"],"abbrev":["MHEV"],"designation":"AlgSwe2012","exemplar":true,"accession":"KF951328","coverage":"Coding-complete genome","genome":"ssRNA(+)","host":"vertebrates","ictv_url":"https://ictv.global/id/ICTV202113885"}],"geo":null,"syndromes":[],"morphology_key":"Hepeviridae","baltimore_key":"IV","biosafety_ref":"family:Hepeviridae"},"root/riboviria/orthornavirae/kitrinoviricota/alsuviricetes/hepelivirales/hepeviridae/orthohepevirinae/paslahepevirus/paslahepevirus-balayani":{"name":"Paslahepevirus balayani","rank":"species","n_species":1,"tiers":{"established":1},"top_tier":"established","note":null,"meta":{"species":"Paslahepevirus balayani","genus":"Paslahepevirus","family":"Hepeviridae","genome":"ssRNA(+)","host":"vertebrates","hosts":["Vertebrates"],"serogroup":null,"clade":null,"profiled":true,"profile":{"cycle":"faecal-oral","names":["hepatitis E virus genotypes 1-4 (HEV)"],"tier":"established","headline":"The commonest cause of acute viral hepatitis worldwide, and two diseases in one species: a waterborne epidemic hepatitis of low-income settings, and a zoonotic foodborne infection of high-income ones.","syndrome":"Self-limiting acute hepatitis in most. Three features set it apart: mortality of 20-25% in the third trimester of pregnancy with genotype 1, which no other hepatitis virus approaches; chronic infection with rapid fibrosis in the immunosuppressed, particularly solid-organ transplant recipients, with genotypes 3 and 4; and extrahepatic neurological disease, chiefly Guillain-Barré syndrome and neuralgic amyotrophy.","transmission":"Genotypes 1 and 2 are faecal-oral through contaminated water, causing large epidemics in camps and after floods. Genotypes 3 and 4 are zoonotic, acquired from undercooked pork, wild boar, deer meat and offal. Transfusion transmission is documented, and vertical transmission occurs with genotype 1.","vectors":["None"],"reservoir":"Humans for genotypes 1 and 2; domestic pigs, wild boar and deer for genotypes 3 and 4, with pigs seropositive across most of the world.","geography":"Worldwide. Genotype 1 predominates in Asia and Africa, genotype 2 in Mexico and West Africa, genotype 3 across Europe, the Americas and Japan, and genotype 4 in east Asia.","incubation":"2-10 weeks, averaging about 40 days.","diagnosis":"Anti-HEV IgM with IgG, and HEV RNA in blood or stool — RNA is essential in the immunosuppressed, in whom serology is unreliable, and is what defines chronicity at three months.","management":"Supportive for acute infection. For chronic genotype 3 infection, reducing immunosuppression clears about a third; ribavirin monotherapy for three months clears most of the rest. Pegylated interferon is used in liver-transplant recipients, avoided in other organs because of rejection risk.","prevention":"Safe water and sanitation for genotypes 1 and 2; thorough cooking of pork and game for 3 and 4. Hecolin, a recombinant vaccine, is licensed only in China, so no vaccine is available to travellers or to pregnant women in the settings where genotype 1 kills them.","evidence":["Established by human volunteer transmission, molecular cloning in 1990, and extensive outbreak and cohort data; the EASL guideline summarises the clinical evidence base."],"refs":[{"label":"EASL Clinical Practice Guidelines on hepatitis E virus infection. J Hepatol 2018","pmid":"29609832","doi":"10.1016/j.jhep.2018.03.005"},{"label":"The global epidemiology of hepatitis E virus infection: A systematic review and meta-analysis. Liver Int 2020","pmid":"32281721","doi":"10.1111/liv.14468"}]},"tier":"established","basis":"profile"},"isolates":[{"names":["human hepatitis E virus genotype 1a"],"abbrev":["HEV"],"designation":"Burma","exemplar":true,"accession":"M73218","coverage":"Coding-complete genome","genome":"ssRNA(+)","host":"vertebrates","ictv_url":"https://ictv.global/id/ICTV19950816"},{"names":["camel hepatitis E virus genotype 7a"],"abbrev":["HEV"],"designation":"DcHEV/178C","exemplar":false,"accession":"KJ496143","coverage":"Complete genome","genome":"ssRNA(+)","host":"vertebrates","ictv_url":"https://ictv.global/id/ICTV19950816"},{"names":["camel hepatitis E virus genotype 8a"],"abbrev":["HEV"],"designation":"BcHEV/12XJ","exemplar":false,"accession":"KX387865","coverage":"Complete genome","genome":"ssRNA(+)","host":"vertebrates","ictv_url":"https://ictv.global/id/ICTV19950816"},{"names":["human hepatitis E virus genotype 1a"],"abbrev":["HEV"],"designation":"China B","exemplar":false,"accession":"L08816","coverage":"Coding-complete genome","genome":"ssRNA(+)","host":"vertebrates","ictv_url":"https://ictv.global/id/ICTV19950816"},{"names":["hum