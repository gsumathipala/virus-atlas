hepatitis","label":"Hepatitis","score":3.0,"matched":"Hepatit"}],"morphology_key":"Kolmioviridae","baltimore_key":"V","biosafety_ref":"family:Kolmioviridae"},"root/ribozyviria/kolmioviridae/deltavirus/deltavirus-carense":{"name":"Deltavirus carense","rank":"species","n_species":1,"tiers":{"established":1},"top_tier":"established","note":null,"meta":{"species":"Deltavirus carense","genus":"Deltavirus","family":"Kolmioviridae","genome":"ssRNA(-)","host":"vertebrates","hosts":["Vertebrates"],"serogroup":null,"clade":null,"profiled":false,"tier":"established","basis":"reference","tier_note":"Hepatitis D virus genotype 6. West and Central Africa."},"isolates":[{"names":["hepatitis D virus 6"],"abbrev":["HDV6"],"designation":"dFr48","exemplar":true,"accession":"AX741164","coverage":"Complete genome","genome":"ssRNA(-)","host":"vertebrates","ictv_url":"https://ictv.global/id/ICTV202009298"}],"geo":{"text":"Hepatitis D virus genotype 6. West and Central Africa.","countries":["Benin","Burkina Faso","Cabo Verde","Cameroon","Central African Rep.","Chad","Congo","Côte d'Ivoire","Dem. Rep. Congo","Eq. Guinea","Gabon","Gambia","Ghana","Guinea","Guinea-Bissau","Liberia","Mali","Mauritania","Niger","Nigeria","Sao Tome and Principe","Senegal","Sierra Leone","Togo"],"worldwide":false,"matched":["central africa","west africa"],"source":"prose","eradicated":false},"syndromes":[{"key":"hepatitis","label":"Hepatitis","score":3.0,"matched":"Hepatit"}],"morphology_key":"Kolmioviridae","baltimore_key":"V","biosafety_ref":"family:Kolmioviridae"},"root/ribozyviria/kolmioviridae/deltavirus/deltavirus-italiense":{"name":"Deltavirus italiense","rank":"species","n_species":1,"tiers":{"established":1},"top_tier":"established","note":null,"meta":{"species":"Deltavirus italiense","genus":"Deltavirus","family":"Kolmioviridae","genome":"ssRNA(-)","host":"vertebrates","hosts":["Vertebrates"],"serogroup":null,"clade":null,"profiled":true,"profile":{"cycle":"blood-sexual","names":["hepatitis D virus genotype 1 (HDV-1)"],"tier":"established","headline":"A satellite virus that cannot replicate without hepatitis B surface antigen, and the most aggressive form of chronic viral hepatitis there is.","syndrome":"Coinfection with hepatitis B produces a more severe acute hepatitis and a higher rate of fulminant failure. Superinfection of an established HBsAg carrier produces rapidly progressive chronic hepatitis: cirrhosis in a substantial minority within a decade, and a two- to sixfold excess of hepatocellular carcinoma over hepatitis B alone.","transmission":"As for hepatitis B — percutaneous and sexual. Perinatal transmission is uncommon, which is why the age distribution differs from hepatitis B's.","vectors":["None"],"reservoir":"People with hepatitis B. Nothing else can sustain it: the agent borrows HBsAg for its envelope and has no way into a cell without it.","geography":"Genotype 1 is the globally distributed genotype, across the Mediterranean basin, eastern Europe, the Middle East, and parts of Africa and the Americas.","incubation":"1-6 months, overlapping that of hepatitis B.","diagnosis":"Anti-HDV in anyone HBsAg-positive — WHO recommends reflex testing of all of them, because risk-based testing misses most cases — confirmed by HDV RNA. Quantitative RNA is poorly standardised between laboratories.","management":"Bulevirtide, an NTCP entry inhibitor, is licensed in the EU and achieved a combined virological and biochemical response in 45% at 48 weeks against 2% untreated. Pegylated interferon alfa has limited and poorly durable efficacy. Hepatitis B nucleos(t)ide analogues do nothing to HDV, which is a common and consequential misunderstanding.","prevention":"Hepatitis B vaccination prevents hepatitis D absolutely, since no HBsAg means no HDV. For those already HBsAg-positive there is no vaccine, and prevention is avoiding percutaneous and sexual exposure.","evidence":["Established since 1977 as the delta antigen of Rizzetto, with the dependence on HBsAg demonstrated experimentally and the superinfection course documented in cohorts; bulevirtide's phase 3 trial is randomised evidence of benefit."],"refs":[{"label":"The global prevalence of hepatitis D virus infection: Systematic review and meta-analysis. J Hepatol 2020","pmid":"32335166","doi":"10.1016/j.jhep.2020.04.008"},{"label":"A Phase 3, Randomized Trial of Bulevirtide in Chronic Hepatitis D. N Engl J Med 2023","pmid":"37345876","doi":"10.1056/nejmoa2213429"}]},"tier":"established","basis":"profile"},"isolates":[{"names":["hepatitis D virus 1"],"abbrev":["HDV1"],"designation":"TW2667","exemplar":true,"accession":"AF104263","coverage":"Complete genome","genome":"ssRNA(-)","host":"vertebrates","ictv_url":"https://ictv.global/id/ICTV19931851"}],"geo":{"text":"Reported worldwide: this species circulates on every inhabited continent, which is why no country list is held for it.","countries":[],"worldwide":true,"matched":[],"source":"worldwide","eradicated":false},"syndromes":[{"key":"hepatitis","label":"Hepatitis","score":2.947,"matched":"hepatit"},{"key":"oncogenic","label":"Malignancy","score":2.051,"matched":"carcinom"}],"morphology_key":"Kolmioviridae","baltimore_key":"V","biosafety_ref":"family:Kolmioviridae","receptors_ref":"Deltavirus italiense","countermeasures_ref":"Deltavirus italiense","therapeutics_ref":"Deltavirus italiense"},"root/ribozyviria/kolmioviridae/deltavirus/deltavirus-japanense":{"name":"Deltavirus japanense","rank":"species","n_species":1,"tiers":{"established":1},"top_tier":"established","note":null,"meta":{"species":"Deltavirus japanense","genus":"Deltavirus","family":"Kolmioviridae","genome":"ssRNA(-)","host":"vertebrates","hosts":["Vertebrates"],"serogroup":null,"clade":null,"profiled":false,"tier":"established","basis":"reference","tier_note":"Hepatitis D virus genotype 2. East Asia; generally milder course than genotype 1."},"isolates":[{"names":["hepatitis D virus 2"],"abbrev":["HDV2"],"designation":"TW2476","exemplar":true,"accession":"AF1